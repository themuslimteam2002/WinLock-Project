<!--
    ToastHost.xaml — non-intrusive notification overlay.

    Positioned at the bottom-right of the main window, above all other content but outside the
    layout flow. Toasts slide in from the right and fade out after their timer expires.

    The ItemsControl is reversed (newest at the bottom, closest to the action area) so a toast
    that arrives while the user is looking at the status strip or a button does not push the one
    they are reading away from the click point.
-->
<UserControl x:Class="AppGuardian.UI.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:AppGuardian.UI.Services"
             IsHitTestVisible="True"
             Focusable="False">

  <ItemsControl ItemsSource="{Binding Items}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Focusable="False">

    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>

    <ItemsControl.ItemTemplate>
      <DataTemplate DataType="{x:Type svc:ToastItem}">
        <Border x:Name="Toast"
                MinWidth="280"
                MaxWidth="400"
                Margin="0,6,0,0"
                Padding="14,10,14,10"
                CornerRadius="8"
                Background="{DynamicResource Surface.Card}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                RenderTransformOrigin="1,0.5"
                Cursor="Hand"
                MouseLeftButtonUp="OnToastClick">

          <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="4"
                              Direction="270"
                              Opacity="0.25"
                              Color="#000000" />
          </Border.Effect>

          <Border.RenderTransform>
            <TransformGroup>
              <TranslateTransform x:Name="SlideTransform" X="40" />
              <ScaleTransform />
            </TransformGroup>
          </Border.RenderTransform>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Level indicator bar -->
            <Border x:Name="LevelBar"
                    Grid.Column="0"
                    Width="3"
                    CornerRadius="2"
                    Margin="0,0,10,0"
                    Background="{DynamicResource Accent}" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Message}"
                       Style="{StaticResource Text.Body}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />

            <!-- Dismiss button -->
            <Button Grid.Column="2"
                    Content="✕"
                    FontSize="11"
                    Padding="4,2"
                    MinHeight="0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource Button.Quiet}"
                    Foreground="{DynamicResource Text.Muted}"
                    Click="OnDismissClick"
                    ToolTip="Dismiss"
                    AutomationProperties.Name="Dismiss notification" />
          </Grid>
        </Border>

        <!-- Level-specific colour for the indicator bar -->
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:ToastLevel.Success}">
            <Setter TargetName="LevelBar" Property="Background" Value="{DynamicResource State.Good}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:ToastLevel.Warning}">
            <Setter TargetName="LevelBar" Property="Background" Value="{DynamicResource State.Warn}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:ToastLevel.Error}">
            <Setter TargetName="LevelBar" Property="Background" Value="{DynamicResource State.Bad}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding Level}" Value="{x:Static svc:ToastLevel.Info}">
            <Setter TargetName="LevelBar" Property="Background" Value="{DynamicResource Accent}" />
          </DataTrigger>

          <!-- Entrance animation: slide in from the right + fade -->
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Toast"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1"
                                 Duration="0:0:0.25"
                                 EasingFunction="{StaticResource EaseOut}" />
                <DoubleAnimation Storyboard.TargetName="SlideTransform"
                                 Storyboard.TargetProperty="X"
                                 From="40" To="0"
                                 Duration="0:0:0.25"
                                 EasingFunction="{StaticResource EaseOut}" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
