<!--
    Metrics.xaml — the spacing, radius and motion scale. No colour, no styles.

    Why this file exists: before it, the UI project carried 38 distinct Margin values, 12 distinct
    Padding values and four different CornerRadius values, and the radius inconsistency was inside
    Theme.xaml itself (Button.Quiet used 4 while the other three buttons used 6). None of that was
    visible in review, because every one of those numbers looked reasonable on its own line. Naming
    them is what makes a wrong one obvious.

    The scale is 4 / 8 / 12 / 16 / 24 / 32. Everything in the app is one of those six numbers or zero.
    There is no 10, no 14 and no 20 — those were the values that had quietly accumulated, and each of
    them was within two pixels of a scale step, which is exactly why nobody caught them.

    Tokens are named by role rather than by number (Pad.Row, not Pad.12x10). A role name survives a
    decision to make every row a little taller; a number name has to be renamed or, worse, lies.

    Thickness and CornerRadius are declared as literal resource elements because WPF's Margin, Padding
    and CornerRadius properties take structs, not doubles — there is no way to write
    Margin="{StaticResource Space.16}" against a numeric resource, so the struct itself is the token.

    Merged after the palette and before Theme.xaml. Theme.xaml reaches these with StaticResource: they
    do not change at runtime, and a DynamicResource lookup per visual for a value that is constant for
    the life of the process is waste.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==================== the scale ==================== -->

  <Thickness x:Key="Space.None">0</Thickness>

  <!--
      Vertical flow. Top-only thicknesses, because everything in this app that stacks does so in a
      StackPanel or a Grid row, and a bottom margin on one child plus a top margin on the next
      collapses in CSS but adds up in WPF. Top-only means the gap between two elements is one number
      belonging to one element, which is the bug class this replaces.
  -->
  <Thickness x:Key="Space.Stack.XS">0,4,0,0</Thickness>
  <Thickness x:Key="Space.Stack.S">0,8,0,0</Thickness>
  <Thickness x:Key="Space.Stack.M">0,12,0,0</Thickness>
  <Thickness x:Key="Space.Stack.L">0,16,0,0</Thickness>
  <Thickness x:Key="Space.Stack.XL">0,24,0,0</Thickness>

  <!-- Horizontal flow, for a control sitting to the right of another. -->
  <Thickness x:Key="Space.Inline.S">8,0,0,0</Thickness>
  <Thickness x:Key="Space.Inline.M">12,0,0,0</Thickness>

  <!-- A gap that has to exist on both sides of something, such as a divider. -->
  <Thickness x:Key="Space.Divider">0,16,0,16</Thickness>

  <!-- ==================== insets ==================== -->

  <Thickness x:Key="Pad.XS">4</Thickness>
  <Thickness x:Key="Pad.S">8</Thickness>
  <Thickness x:Key="Pad.M">12</Thickness>
  <Thickness x:Key="Pad.L">16</Thickness>
  <Thickness x:Key="Pad.XL">24</Thickness>

  <!--
      Control insets. Asymmetric on purpose: 12 across and 8 down puts a 13px label optically centred
      in a 32px control without the label sitting low, which is what the old 14,7 was reaching for.
  -->
  <Thickness x:Key="Pad.Control">12,8</Thickness>
  <Thickness x:Key="Pad.Control.Small">8,4</Thickness>
  <Thickness x:Key="Pad.Input">12,8</Thickness>
  <Thickness x:Key="Pad.Row">12,8</Thickness>
  <Thickness x:Key="Pad.Banner">12,8</Thickness>
  <Thickness x:Key="Pad.Badge">8,4</Thickness>

  <!--
      Page chrome. 24 on the sides is the widest inset in the app and belongs only to a page root; the
      extra 8 at the bottom of a scrolling page keeps the last card off the window edge, which reads as
      a mistake rather than as a tight layout.
  -->
  <Thickness x:Key="Pad.Page">24,16,24,16</Thickness>
  <Thickness x:Key="Pad.Page.Scrolling">24,16,24,24</Thickness>
  <Thickness x:Key="Pad.Header">24,16,24,16</Thickness>

  <!-- ==================== radii ==================== -->

  <!--
      Three radii, one per size class, and nothing may invent a fourth. The rule is that radius tracks
      the size of the box: a 20px badge at radius 8 looks like a pill by accident, and a 200px card at
      radius 4 looks unfinished.
  -->
  <CornerRadius x:Key="Radius.Small">4</CornerRadius>
  <CornerRadius x:Key="Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Radius.Card">8</CornerRadius>

  <!-- Half of the switch track's height. Not a general-purpose "pill" — the switch is the only pill. -->
  <CornerRadius x:Key="Radius.Switch">9</CornerRadius>

  <!-- ==================== motion ==================== -->

  <!--
      Four durations, and the ceiling is 250 ms for the same reason Animations.xaml documents: this is a
      utility that people open to do one thing, and an animation they have to wait through is a tax on
      every visit.

      Hover and press are the two the user triggers most often and the two that must feel instant.
      Anything at or below about 120 ms is perceived as a direct response to the pointer rather than as
      an animation, which is the point — the motion is there to stop the colour snapping, not to be
      noticed.
  -->
  <Duration x:Key="Motion.Press">0:0:0.09</Duration>
  <Duration x:Key="Motion.Hover">0:0:0.14</Duration>
  <Duration x:Key="Motion.Base">0:0:0.2</Duration>
  <Duration x:Key="Motion.Enter">0:0:0.25</Duration>

</ResourceDictionary>
