<!--
    Animations.xaml — reusable easing functions and storyboard helpers.

    Kept in a resource dictionary rather than inlined in each view: every page uses the same
    entrance transition, and four copies of the same storyboard would drift the moment someone
    tuned a duration on one page and forgot the others.

    All durations are short — 200–250 ms — because animation that takes longer than a blink
    becomes the thing the user is waiting for rather than a refinement they barely notice.
    Anything over 300 ms on a page navigation would make the dashboard feel sluggish.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ======== easing functions ======== -->

  <!--
      Cubic ease-out: starts fast, decelerates. Used for entrances — the content
      arrives promptly and settles in, rather than accelerating towards its
      resting position.
  -->
  <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

  <!--
      Cubic ease-in: accelerates towards the end. Used for exits — the element
      starts from rest and picks up speed as it leaves, which reads as a clean
      departure rather than a sudden pop.
  -->
  <CubicEase x:Key="EaseIn" EasingMode="EaseIn" />

  <!--
      Cubic ease-in-out: for transitions that start and end in place, like a
      theme cross-fade or a pulse. Neither end feels sudden.
  -->
  <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut" />

  <!-- ======== page entrance ======== -->

  <!--
      Page content entrance: a combined fade + slide-up applied to every page's root
      on Loaded. The translate is 16 px — enough to give a sense of direction without
      making the user's eye chase content across the window.

      Triggered via an EventTrigger on Loaded in PageTemplates.xaml. Using Loaded rather
      than a DataTrigger on the shell's CurrentId avoids a binding dependency and fires
      on the first show as well as on re-navigation.
  -->
  <Storyboard x:Key="PageEnter">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1"
                     Duration="0:0:0.2"
                     EasingFunction="{StaticResource EaseOut}" />
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                     From="16" To="0"
                     Duration="0:0:0.2"
                     EasingFunction="{StaticResource EaseOut}" />
  </Storyboard>

  <!-- ======== status dot pulse ======== -->

  <!--
      A gentle opacity pulse for the status dot when the system is degraded or unreachable.
      0.5 → 1.0 → 0.5 on a 2-second cycle, with ease-in-out so the pulse feels organic.

      Triggered by a DataTrigger on IsDegraded=True in MainWindow.xaml. Stops (and resets to
      full opacity) when the state returns to normal.

      A 2s cycle rather than 1s: faster pulses read as urgency, and a degraded service is a
      situation the user should know about but not panic over — the service usually starts on
      its own within seconds.
  -->
  <Storyboard x:Key="PulseStatus" RepeatBehavior="Forever">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0.5" To="1.0"
                     Duration="0:0:1.0"
                     AutoReverse="True"
                     EasingFunction="{StaticResource EaseInOut}" />
  </Storyboard>

  <!-- ======== lock overlay entrance ======== -->

  <!--
      Lock screen overlay entrance: a smooth fade (0 -> 0.97 opacity) and slide-up
      (from 24px) for the auth card when a locked app is brought to the foreground.
  -->
  <Storyboard x:Key="LockOverlayEnter">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1"
                     Duration="0:0:0.25"
                     EasingFunction="{StaticResource EaseOut}" />
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                     From="24" To="0"
                     Duration="0:0:0.25"
                     EasingFunction="{StaticResource EaseOut}" />
  </Storyboard>

  <!-- ======== card stagger/entrance ======== -->

  <Storyboard x:Key="CardEnter">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1"
                     Duration="0:0:0.18"
                     EasingFunction="{StaticResource EaseOut}" />
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                     From="8" To="0"
                     Duration="0:0:0.18"
                     EasingFunction="{StaticResource EaseOut}" />
  </Storyboard>

  <!-- ======== wizard step change ======== -->

  <!--
      Onboarding advances between four steps inside one page, so there is no navigation for PageEnter
      to hook. This is the same idea at a shorter throw: 12 px instead of 16, because the step's frame
      does not move and a large slide inside a stationary card reads as the content having come loose.

      Applied by an EventTrigger on Loaded inside each step's container. The steps are separate
      elements gated on visibility, so switching steps realises a new container and fires Loaded.
  -->
  <Storyboard x:Key="WizardStepEnter">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1"
                     Duration="0:0:0.22"
                     EasingFunction="{StaticResource EaseOut}" />
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                     From="12" To="0"
                     Duration="0:0:0.22"
                     EasingFunction="{StaticResource EaseOut}" />
  </Storyboard>

  <!-- ======== dashboard reveal ======== -->

  <!--
      The one moment in the app that earns a scale animation: onboarding clears and the whole dashboard
      — navigation rail, status strip and page — appears for the first time. It runs once per install.

      Scale starts at 0.985, not 0.9. A large scale-up on a window-filling element looks like a mobile
      app transition and, worse, resamples every glyph in the window on the way; a 1.5% rise reads as
      the interface settling into place and stays legible throughout.

      Requires the target's RenderTransform to be a ScaleTransform and RenderTransformOrigin to be
      0.5,0.5, or the growth happens from the top-left corner and looks like a layout bug.
  -->
  <Storyboard x:Key="DashboardReveal">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0" To="1"
                     Duration="0:0:0.25"
                     EasingFunction="{StaticResource EaseOut}" />
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                     From="0.985" To="1"
                     Duration="0:0:0.25"
                     EasingFunction="{StaticResource EaseOut}" />
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                     From="0.985" To="1"
                     Duration="0:0:0.25"
                     EasingFunction="{StaticResource EaseOut}" />
  </Storyboard>

  <!-- ======== skeleton placeholder ======== -->

  <!--
      The breathing loop on a skeleton placeholder while a list loads.

      A pulse rather than the sweeping gradient shimmer that is fashionable: a shimmer needs a moving
      LinearGradientBrush per placeholder block, and this app puts six of them on screen at once during
      the app enumeration, which is precisely the moment the machine is busiest. Opacity on a solid
      brush composites on the GPU and costs nothing.

      0.9 s each way, well outside the 250 ms envelope the rest of this file keeps to, and deliberately
      so: this is ambient rather than a response to an action. Faster reads as an error state.
  -->
  <Storyboard x:Key="SkeletonPulse" RepeatBehavior="Forever">
    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0.45" To="0.9"
                     Duration="0:0:0.9"
                     AutoReverse="True"
                     EasingFunction="{StaticResource EaseInOut}" />
  </Storyboard>

</ResourceDictionary>
