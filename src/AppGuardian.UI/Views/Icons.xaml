<!--
    Icons.xaml — vector geometry only. No brushes, no sizes, no styles.

    Every glyph is drawn in a 24 x 24 box and is meant to be *stroked*, not filled: consumers set
    Stroke to a palette brush and StrokeThickness to 1.5, which is what lets one icon set work in both
    palettes and inherit the accent colour without a second copy per theme. Nothing here references a
    colour, so nothing here has to change when the theme swaps.

    Drawn rather than imported. A raster asset would need a set per DPI and would not recolour; an icon
    font would be a redistributable dependency in an app whose whole pitch is that it ships nothing it
    does not need. Geometry costs nothing at runtime and is a diff a reviewer can read.

    Sizing rule: render these at 24 and do not scale them far from it. WPF strokes a Shape with a pen
    of StrokeThickness in final device units — Stretch transforms the geometry but not the pen — so a
    24px glyph shown at 56px keeps its 1.5px stroke and arrives looking hairline and unrelated to every
    other icon on the page. Where a glyph needs more visual weight, as in an empty state or a wizard
    step, render it at 24 inside a larger tinted badge. That is what EmptyState does, and it is why
    there is only one size of path data in this file.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==================== the product's own vocabulary ==================== -->

  <!-- Protection, as a whole. The hero glyph on the first onboarding screen. -->
  <PathGeometry x:Key="Icon.Shield"
                Figures="M12,3 L19.5,5.8 V11.2 C19.5,15.9 16.4,20 12,21.3 C7.6,20 4.5,15.9 4.5,11.2 V5.8 Z" />

  <PathGeometry x:Key="Icon.ShieldCheck"
                Figures="M12,3 L19.5,5.8 V11.2 C19.5,15.9 16.4,20 12,21.3 C7.6,20 4.5,15.9 4.5,11.2 V5.8 Z
                         M8.9,11.7 L11.2,14 L15.3,9.9" />

  <!-- Locked. Closed shackle. -->
  <PathGeometry x:Key="Icon.Lock"
                Figures="M4,11.5 A1.5,1.5 0 0 1 5.5,10 H18.5 A1.5,1.5 0 0 1 20,11.5 V19.5
                         A1.5,1.5 0 0 1 18.5,21 H5.5 A1.5,1.5 0 0 1 4,19.5 Z
                         M7.75,10 V6.75 A4.25,4.25 0 0 1 16.25,6.75 V10" />

  <!-- Unlocked. Same body, shackle swung open — the difference is legible at 24px, which is the test. -->
  <PathGeometry x:Key="Icon.Unlock"
                Figures="M4,11.5 A1.5,1.5 0 0 1 5.5,10 H18.5 A1.5,1.5 0 0 1 20,11.5 V19.5
                         A1.5,1.5 0 0 1 18.5,21 H5.5 A1.5,1.5 0 0 1 4,19.5 Z
                         M7.75,10 V6.75 A4.25,4.25 0 0 1 16.25,6.75" />

  <!-- Hidden. An eye with a slash, the one convention everybody already reads correctly. -->
  <PathGeometry x:Key="Icon.EyeOff"
                Figures="M3.5,3.5 L20.5,20.5
                         M10.7,6.4 A9.5,9.5 0 0 1 12,6.3 C16.4,6.3 20.1,9.4 21.5,12
                         C21,13 20.3,13.9 19.4,14.8
                         M16.2,16.8 C14.9,17.4 13.5,17.7 12,17.7 C7.6,17.7 3.9,14.6 2.5,12
                         C3.2,10.7 4.2,9.4 5.5,8.4
                         M9.9,9.9 A3,3 0 0 0 14.1,14.1" />

  <!-- Battery limits. Level bar drawn low on purpose: the feature is about using less. -->
  <PathGeometry x:Key="Icon.Battery"
                Figures="M3,8.5 A1.5,1.5 0 0 1 4.5,7 H16 A1.5,1.5 0 0 1 17.5,8.5 V15.5
                         A1.5,1.5 0 0 1 16,17 H4.5 A1.5,1.5 0 0 1 3,15.5 Z
                         M20,10.5 V13.5
                         M5.5,9.5 H9 V14.5 H5.5 Z" />

  <!-- The app inventory. Four tiles, because that is what a list of applications looks like. -->
  <PathGeometry x:Key="Icon.Apps"
                Figures="M4,5.5 A1.5,1.5 0 0 1 5.5,4 H8.5 A1.5,1.5 0 0 1 10,5.5 V8.5
                         A1.5,1.5 0 0 1 8.5,10 H5.5 A1.5,1.5 0 0 1 4,8.5 Z
                         M14,5.5 A1.5,1.5 0 0 1 15.5,4 H18.5 A1.5,1.5 0 0 1 20,5.5 V8.5
                         A1.5,1.5 0 0 1 18.5,10 H15.5 A1.5,1.5 0 0 1 14,8.5 Z
                         M4,15.5 A1.5,1.5 0 0 1 5.5,14 H8.5 A1.5,1.5 0 0 1 10,15.5 V18.5
                         A1.5,1.5 0 0 1 8.5,20 H5.5 A1.5,1.5 0 0 1 4,18.5 Z
                         M14,15.5 A1.5,1.5 0 0 1 15.5,14 H18.5 A1.5,1.5 0 0 1 20,15.5 V18.5
                         A1.5,1.5 0 0 1 18.5,20 H15.5 A1.5,1.5 0 0 1 14,18.5 Z" />

  <!-- The audit log. A pulse, not a scroll: the page is about things that happened, in order. -->
  <PathGeometry x:Key="Icon.Activity"
                Figures="M3,12 H7 L9.5,5.5 L14,18.5 L16.5,12 H21" />

  <!-- ==================== onboarding and system access ==================== -->

  <!-- Windows Hello. -->
  <PathGeometry x:Key="Icon.Fingerprint"
                Figures="M6.2,17.8 A9,9 0 0 1 6.2,6.2
                         M8.6,15.9 A6,6 0 0 1 8.6,8.1
                         M11,14.3 A3,3 0 0 1 11,9.7
                         M17.8,6.2 A9,9 0 0 1 17.8,17.8
                         M15.4,8.1 A6,6 0 0 1 15.4,15.9
                         M13,9.7 A3,3 0 0 1 13,14.3" />

  <!-- The background service. -->
  <PathGeometry x:Key="Icon.Service"
                Figures="M12,15.2 A3.2,3.2 0 1 1 12,8.8 A3.2,3.2 0 1 1 12,15.2 Z
                         M12,2.5 V5 M12,19 V21.5 M2.5,12 H5 M19,12 H21.5
                         M5.3,5.3 L7,7 M17,17 L18.7,18.7 M18.7,5.3 L17,7 M7,17 L5.3,18.7" />

  <!-- The desktop agent, which is the part that actually runs in the user's session. -->
  <PathGeometry x:Key="Icon.Desktop"
                Figures="M3,6 A1.5,1.5 0 0 1 4.5,4.5 H19.5 A1.5,1.5 0 0 1 21,6 V15
                         A1.5,1.5 0 0 1 19.5,16.5 H4.5 A1.5,1.5 0 0 1 3,15 Z
                         M12,16.5 V20 M8.5,20 H15.5" />

  <!-- Notifications. -->
  <PathGeometry x:Key="Icon.Bell"
                Figures="M18,16.5 H6 C6.9,15.5 7.4,14.2 7.4,12.8 V10.5 A4.6,4.6 0 0 1 16.6,10.5 V12.8
                         C16.6,14.2 17.1,15.5 18,16.5 Z
                         M9.6,19.3 A2.6,2.6 0 0 0 14.4,19.3" />

  <!-- Setup finished. Used once, on the last wizard step. -->
  <PathGeometry x:Key="Icon.Sparkle"
                Figures="M12,3 L13.9,9.1 L20,11 L13.9,12.9 L12,19 L10.1,12.9 L4,11 L10.1,9.1 Z" />

  <!-- ==================== affordances ==================== -->

  <PathGeometry x:Key="Icon.Check" Figures="M5,12.6 L9.5,17 L19,7.2" />
  <PathGeometry x:Key="Icon.Plus" Figures="M12,5 V19 M5,12 H19" />
  <PathGeometry x:Key="Icon.ArrowRight" Figures="M4,12 H19 M13,6 L19,12 L13,18" />
  <PathGeometry x:Key="Icon.ArrowLeft" Figures="M20,12 H5 M11,6 L5,12 L11,18" />

  <!-- The combo box's drop-down affordance. Deliberately the only chevron in the app. -->
  <PathGeometry x:Key="Icon.Chevron" Figures="M8,10.3 L12,14.3 L16,10.3" />

  <!-- The indeterminate check-box glyph. No control in the app is three-state, but the template
       renders it rather than showing an indeterminate box as if it were simply unchecked. -->
  <PathGeometry x:Key="Icon.Dash" Figures="M7,12 H17" />

  <!-- "This opens Windows Settings." Signalling that the click leaves the app is the whole job. -->
  <PathGeometry x:Key="Icon.External"
                Figures="M14,4 H20 V10 M20,4 L12.4,11.6
                         M18,14.5 V19 A1.5,1.5 0 0 1 16.5,20.5 H5.5 A1.5,1.5 0 0 1 4,19 V8
                         A1.5,1.5 0 0 1 5.5,6.5 H10" />

  <PathGeometry x:Key="Icon.Search"
                Figures="M15.6,15.6 L20.5,20.5
                         M10.5,17 A6.5,6.5 0 1 1 10.5,4 A6.5,6.5 0 1 1 10.5,17 Z" />

  <!--
      Alert and Info. The trailing hairline segments are the dots: a zero-length figure is not
      guaranteed to raster even with a round cap, so each dot is a 0.2-unit line instead.
  -->
  <PathGeometry x:Key="Icon.Alert"
                Figures="M12,4.5 L21,19.5 H3 Z M12,9.8 V14.2 M12,16.7 V16.9" />

  <PathGeometry x:Key="Icon.Info"
                Figures="M12,21 A9,9 0 1 1 12,3 A9,9 0 1 1 12,21 Z M12,11.2 V16.2 M12,7.8 V8" />

</ResourceDictionary>
