<!--
    AppsView.xaml — the app picker and rule editor. FR-500–FR-509, FR-800.

    Two panes: the list of apps on the left, the selected app's rules on the right. Picking and
    configuring are on one screen because the common case is "lock this one app", and splitting it
    into a wizard would make that a four-screen journey.

    Every toggle on the right saves as soon as it changes — there is no Save button. A rule that
    exists only in this window is a rule the user believes is protecting them.
-->
<UserControl x:Class="AppGuardian.UI.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AppGuardian.UI.ViewModels"
             xmlns:views="clr-namespace:AppGuardian.UI.Views"
             d:DataContext="{d:DesignInstance Type=vm:AppsViewModel}"
             mc:Ignorable="d">

  <Grid Margin="{StaticResource Pad.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource Text.Heading}" Text="{Binding Title}" />

    <ContentControl Grid.Row="1" Style="{StaticResource PageBanner}" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="260" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="3*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- ============ left: the list ============ -->
      <Border Grid.Column="0" Style="{StaticResource Card.Flush}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="{StaticResource Pad.Row}">
            <!--
                Delay=250 on the filter. It is applied locally, but a keystroke-by-keystroke rebuild of a
                list of several hundred rows is visible as lag on a slow machine.
            -->
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     Style="{StaticResource Input.Base}"
                     AutomationProperties.Name="Filter apps by name" />

            <TextBlock Style="{StaticResource Text.Small}"
                       Margin="{StaticResource Space.Stack.XS}"
                       Text="Type to narrow the list" />

            <CheckBox Content="Only apps with rules"
                      IsChecked="{Binding ShowProtectedOnly}"
                      AutomationProperties.Name="Show only apps with protection rules"
                      Margin="{StaticResource Space.Stack.S}" />
          </StackPanel>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Apps}"
                   SelectedItem="{Binding Selected}"
                   AutomationProperties.Name="Installed apps"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <!--
                Virtualised with recycling. The registry, Start Menu and packaged-app enumeration together
                can return well over a thousand entries on a developer machine, and a row here carries an
                icon.
            -->
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel VirtualizationMode="Recycling" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:AppRowViewModel}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <!--
                      Icons are only fetched for the selected app, so this is empty for most rows. A fixed
                      box rather than a collapsing one, so names line up whether an icon has loaded or not.
                  -->
                  <Border Grid.Column="0" Width="20" Height="20" Margin="0,0,10,0">
                    <Image Source="{Binding IconBase64, Converter={StaticResource Base64Image}}"
                           Stretch="Uniform" />
                  </Border>

                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />

                    <!--
                        FR-509: shown on the row before the user sets anything, not raised as an error
                        after their first save fails.
                    -->
                    <TextBlock Style="{StaticResource Text.Small}"
                               Foreground="{DynamicResource State.Warn}"
                               Text="{Binding UnsupportedReason}"
                               Visibility="{Binding UnsupportedReason,
                                                    Converter={StaticResource TextToVisible}}" />

                    <TextBlock Style="{StaticResource Text.Small}"
                               Text="{Binding SourceLabel}"
                               Visibility="{Binding UnsupportedReason,
                                                    Converter={StaticResource NoTextToVisible}}" />
                  </StackPanel>

                  <!-- A word, not a coloured dot: "Protected" is the state the user is looking for. -->
                  <TextBlock Grid.Column="2"
                             Style="{StaticResource Text.Small}"
                             Foreground="{DynamicResource State.Good}"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Text="Protected"
                             Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisible}}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Margin="{StaticResource Pad.Row}">
            <!--
                FR-503: the manual path. Discovery misses portable executables and anything installed
                without a registry entry, and without this the user simply cannot protect those.
            -->
            <Button Content="Add an app by file…"
                    Style="{StaticResource Button.Quiet}"
                    Click="OnBrowseClick"
                    AutomationProperties.Name="Add an application by executable file"
                    HorizontalAlignment="Left" />

            <TextBlock Style="{StaticResource Text.Small}"
                       Margin="{StaticResource Space.Stack.XS}"
                       Text="Some app icons could not be read and are not shown."
                       Visibility="{Binding IconsOmitted, Converter={StaticResource BoolToVisible}}" />
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="12"
                    Background="Transparent"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" />

      <!-- ============ right: the rules ============ -->
      <Grid Grid.Column="2">
        <TextBlock Style="{StaticResource EmptyState.Text}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="Choose an app on the left to lock it, hide it, or limit what it does to your battery."
                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToCollapsed}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
          <ContentControl Content="{Binding Selected}"
                          Focusable="False"
                          ContentTemplate="{StaticResource RuleEditorTemplate}" />
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
