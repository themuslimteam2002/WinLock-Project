                <Border Style="{StaticResource Skeleton.Block}" Width="78" Height="8"
                        Margin="{StaticResource Space.Stack.S}" />
              </StackPanel>
            </Grid>

            <Grid Margin="{StaticResource Pad.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Skeleton.Block}" Width="24" Height="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="{StaticResource Space.Inline.M}" VerticalAlignment="Center">
                <Border Style="{StaticResource Skeleton.Block}" Width="204" Height="10" />
                <Border Style="{StaticResource Skeleton.Block}" Width="132" Height="8"
                        Margin="{StaticResource Space.Stack.S}" />
              </StackPanel>
            </Grid>

            <Grid Margin="{StaticResource Pad.Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Skeleton.Block}" Width="24" Height="24" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="{StaticResource Space.Inline.M}" VerticalAlignment="Center">
                <Border Style="{StaticResource Skeleton.Block}" Width="152" Height="10" />
                <Border Style="{StaticResource Skeleton.Block}" Width="96" Height="8"
                        Margin="{StaticResource Space.Stack.S}" />
