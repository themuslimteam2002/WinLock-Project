<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AppGuardian.Tests — SRS §14.

    Multi-targeted to match AppGuardian.Shared:

      net8.0          Contract, model, framing, and key-derivation tests. Runs on the
                      Linux CI job, which is what proves the shared layer is portable.

      net8.0-windows  Adds tests that touch real pipes, ACLs, Job Objects, and the
                      virtual desktop adapter. Windows CI job only.

    Windows-only tests live in Windows/ and are excluded from the portable TFM below.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <RootNamespace>AppGuardian.Tests</RootNamespace>
    <AssemblyName>AppGuardian.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Windows\**\*.cs" />
    <Compile Remove="Security\AuthTokenTests.cs" />
    <Compile Remove="Ipc\AuthorizationBypassTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AppGuardian.Shared\AppGuardian.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ProjectReference Include="..\..\src\AppGuardian.Service\AppGuardian.Service.csproj" />
  </ItemGroup>

</Project>
